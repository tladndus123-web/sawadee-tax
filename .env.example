NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max — higher reads more carefully but takes longer and costs more
ANTHROPIC_EFFORT=medium

# LINE bot (LINE Developers → Messaging API channel). Webhook URL: https://<app>/api/line/webhook
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# The bot's LINE ID, e.g. @123abcde (optional: shows an "add friend" button in Settings)
NEXT_PUBLIC_LINE_BOT_ID=
# Address the bot links to (the receipt card's "open in app" button)
NEXT_PUBLIC_APP_URL=http://localhost:3130
# Any long random string; Vercel Cron sends it to /api/cron/due-reminders (daily LINE payment reminder)
CRON_SECRET=
